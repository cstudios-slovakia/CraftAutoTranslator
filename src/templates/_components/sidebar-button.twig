{% set sites = craft.app.sites.allSites %}
{% set currentSiteId = currentSiteId ?? element.siteId %}
{% set currentSite = craft.app.sites.getSiteById(currentSiteId) %}
{% if sites|length > 1 %}
    <div id="auto-translator-sidebar" class="meta" style="margin-top: 20px; border-top: 1px solid rgba(0, 0, 0, 0.1); padding-top: 20px;">
        <div class="data">
            <h5 class="heading">Auto Translator</h5>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px;">
                {# In-place button: translates current site's content to its own language (auto-detect source) #}
                <button type="button" class="btn submit auto-translator-inplace-btn" style="width: 100%; justify-content: center;">
                    Translate
                </button>
                <div style="border-top: 1px solid rgba(0,0,0,0.08); margin: 2px 0;"></div>
                <button type="button" class="btn submit auto-translator-trigger-btn" data-target="all" data-site-name="All Sites" style="width: 100%; justify-content: center;">
                    Translate to All Sites
                </button>
                {% for site in sites %}
                    {% if site.id != currentSiteId %}
                        <button type="button" class="btn auto-translator-trigger-btn" data-target="{{ site.id }}" data-site-name="{{ site.name }}" style="width: 100%; justify-content: center; border-color: #2782c3; color: #2782c3;">
                            Translate to {{ site.name }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    {% js %}
        (function() {
            var _pollInterval = null;

            function stopPolling() {
                if (_pollInterval) {
                    clearInterval(_pollInterval);
                    _pollInterval = null;
                }
            }

            function startPolling(siteName) {
                stopPolling();
                var polls = 0;
                var consecutiveErrors = 0;
                var sawRunning = false; // we want to confirm running was true at least once before deciding "done"
                var maxPolls = 90;

                function doPoll() {
                    polls++;
                    console.log('[AutoTranslator] poll #' + polls + ' for ' + siteName);

                    Craft.sendActionRequest('GET', 'auto-translator/translate/queue-status')
                        .then(function(r) {
                            consecutiveErrors = 0;
                            var data = (r && r.data) || {};
                            console.log('[AutoTranslator] poll result', data);

                            if (data.running) {
                                sawRunning = true;
                                return;
                            }

                            // Not running. Only treat as "done" once we've confirmed the job was actually
                            // running at some point — otherwise we might be polling before the job got picked up.
                            if (!sawRunning && polls < 3) {
                                return; // give it a few more polls to start
                            }

                            stopPolling();
                            if (data.failed && data.failed > 0) {
                                Craft.cp.displayError('Translation failed. Check the Craft queue for details.');
                                enableAllButtons();
                            } else {
                                Craft.cp.displayNotice('Translation to ' + siteName + ' complete! Reloading…');
                                setTimeout(function() { window.location.reload(); }, 1200);
                            }
                        })
                        .catch(function(err) {
                            consecutiveErrors++;
                            console.error('[AutoTranslator] queue-status poll failed (' + consecutiveErrors + ')', err);
                            if (consecutiveErrors >= 3) {
                                stopPolling();
                                enableAllButtons();
                                var status = err && err.response && err.response.status;
                                Craft.cp.displayError('Cannot check translation status (HTTP ' + (status || '?') + '). Reload the page to see translated content.');
                            }
                        });

                    if (polls >= maxPolls) {
                        stopPolling();
                        enableAllButtons();
                        Craft.cp.displayNotice('Translation is still running in the background. Reload manually when ready.');
                    }
                }

                // Poll once immediately, then on interval.
                doPoll();
                _pollInterval = setInterval(doPoll, 2000);
            }

            function disableAllButtons() {
                $('.auto-translator-trigger-btn, .auto-translator-inplace-btn').addClass('loading').attr('disabled', true);
            }

            function enableAllButtons() {
                $('.auto-translator-trigger-btn, .auto-translator-inplace-btn').removeClass('loading').attr('disabled', false);
            }

            $(document).ready(function() {
                // Move sidebar into visible location if it's sitting inside the hidden
                // #auto-translator-injected container that AutoTranslator.php outputs.
                if ($('#auto-translator-sidebar').closest('#auto-translator-injected').length > 0) {
                    var $target = $('#settings, #details').first();
                    if ($target.length > 0) {
                        $target.append($('#auto-translator-sidebar'));
                    }
                }

                // In-place "Translate" button: translate current content to current site's language.
                $(document).on('click', '.auto-translator-inplace-btn', function(e) {
                    e.preventDefault();
                    disableAllButtons();
                    stopPolling();

                    var payload = {
                        elementId: {{ element.id }},
                        siteId: {{ currentSiteId }}
                    };

                    Craft.sendActionRequest('POST', 'auto-translator/translate/translate-in-place', { data: payload })
                        .then(function(response) {
                            Craft.cp.displayNotice('Translation queued. Working…');
                            startPolling('{{ currentSite.name|e('js') }}');
                        })
                        .catch(function(err) {
                            enableAllButtons();
                            var msg = (err && err.response && err.response.data && err.response.data.error)
                                || (err && err.message)
                                || 'Translation failed.';
                            Craft.cp.displayError(msg);
                        });
                });

                // "Translate to X" buttons: translate from current site to target site.
                $(document).on('click', '.auto-translator-trigger-btn', function(e) {
                    e.preventDefault();
                    var $btn = $(this);
                    var targetSiteId = $btn.data('target');
                    var siteName = $btn.data('site-name') || 'site';

                    disableAllButtons();
                    stopPolling();

                    var payload = {
                        elementId: {{ element.id }},
                        sourceSiteId: {{ currentSiteId }},
                        targetSiteId: targetSiteId
                    };

                    Craft.sendActionRequest('POST', 'auto-translator/translate/element', { data: payload })
                        .then(function(response) {
                            var data = (response && response.data) || {};
                            var count = data.jobCount || 1;
                            var label = targetSiteId === 'all'
                                ? count + (count === 1 ? ' job' : ' jobs')
                                : '1 job';

                            Craft.cp.displayNotice('Translation queued for ' + siteName + ' (' + label + '). Working…');
                            startPolling(siteName);
                        })
                        .catch(function(err) {
                            enableAllButtons();
                            var msg = (err && err.response && err.response.data && err.response.data.error)
                                || (err && err.message)
                                || 'Translation failed.';
                            Craft.cp.displayError(msg);
                        });
                });
            }); // document.ready
        })();
    {% endjs %}
{% endif %}
