{% set sites = craft.app.sites.allSites %}
{% set currentSiteId = currentSiteId ?? element.siteId %}
{% set currentSite = craft.app.sites.getSiteById(currentSiteId) %}
{% if sites|length > 1 %}
    <div id="auto-translator-sidebar" style="margin-top: 1.5rem;">
        <h6 style="
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--medium-text-color, #8f98a3);
            margin: 0 0 0.5rem;
            padding: 0;
        ">Auto Translator</h6>
        <div class="meta" style="padding: 0.75rem;">
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {# In-place button: translates current site's content to its own language (auto-detect source) #}
                <button type="button" class="btn submit fullwidth auto-translator-inplace-btn">
                    Auto-translate
                </button>
                <div style="border-top: 1px solid rgba(0,0,0,0.1); margin: 0.15rem 0;"></div>
                <button type="button" class="btn submit fullwidth auto-translator-trigger-btn" data-target="all" data-site-name="All Sites">
                    Translate to All Sites
                </button>
                {% for site in sites %}
                    {% if site.id != currentSiteId %}
                        <button type="button" class="btn fullwidth auto-translator-trigger-btn" data-target="{{ site.id }}" data-site-name="{{ site.name }}" style="border-color: var(--link-color, #2782c3); color: var(--link-color, #2782c3);">
                            Translate to {{ site.name }}
                        </button>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>

    {% js %}
        (function() {
            // Idempotent guard: this block can get registered multiple times when
            // the sidebar template is rendered by both the cp.elements.edit.details
            // hook and the View::EVENT_END_BODY fallback, or when Solspace
            // Calendar's Vue SPA re-mounts. Without this guard, one click fires
            // as many AJAX POSTs as the block has been executed.
            if (window.__autoTranslatorBound) return;
            window.__autoTranslatorBound = true;

            var _pollInterval = null;
            var _serverSiteId = {{ currentSiteId }};

            // Determine which site the user is actually editing — at click time,
            // not at server-render time. Solspace Calendar uses a Vue SPA and the
            // initial server render can't always tell which site tab is active.
            function resolveCurrentSiteId() {
                var sites = (window.Craft && Craft.sites) ? Craft.sites : null;

                // 1. URL path ending in /<id>(-slug)?/<siteHandle> (Solspace pattern)
                var pathMatch = window.location.pathname.match(/\/\d+(?:-[^\/]+)?\/([\w-]+)\/?$/);
                if (pathMatch && sites) {
                    var handle = pathMatch[1];
                    for (var i = 0; i < sites.length; i++) {
                        if (sites[i].handle === handle) return sites[i].id;
                    }
                }

                // 2. ?site= query param (Craft's standard element editor)
                var qs;
                try { qs = new URLSearchParams(window.location.search); } catch (e) { qs = null; }
                var siteParam = qs && qs.get('site');
                if (siteParam && sites) {
                    for (var j = 0; j < sites.length; j++) {
                        if (sites[j].handle === siteParam) return sites[j].id;
                    }
                }

                // 3. Craft's selected primary-nav site (set when user toggles
                //    the site switcher in the CP header)
                if (window.Craft && Craft.cp && Craft.cp.$siteCrumb) {
                    var crumbSiteId = parseInt(Craft.cp.$siteCrumb.data('site-id'), 10);
                    if (crumbSiteId) return crumbSiteId;
                }
                if (window.Craft && Craft.siteId) {
                    return Craft.siteId;
                }

                // 4. Fallback to the server-rendered value
                return _serverSiteId;
            }

            function siteNameForId(siteId) {
                if (window.Craft && Craft.sites) {
                    for (var i = 0; i < Craft.sites.length; i++) {
                        if (Craft.sites[i].id == siteId) return Craft.sites[i].name;
                    }
                }
                return 'site';
            }

            function stopPolling() {
                if (_pollInterval) {
                    clearInterval(_pollInterval);
                    _pollInterval = null;
                }
            }

            function startPolling(siteName) {
                stopPolling();
                var polls = 0;
                var consecutiveErrors = 0;
                var sawRunning = false;
                var maxPolls = 90;

                function doPoll() {
                    polls++;

                    Craft.sendActionRequest('GET', 'auto-translator/translate/queue-status')
                        .then(function(r) {
                            consecutiveErrors = 0;
                            var data = (r && r.data) || {};

                            if (data.running) {
                                sawRunning = true;
                                return;
                            }

                            // Not running. Only treat as "done" once we've confirmed the job was actually
                            // running at some point — otherwise we might be polling before the job got picked up.
                            if (!sawRunning && polls < 3) {
                                return;
                            }

                            stopPolling();
                            if (data.failed && data.failed > 0) {
                                var errMsg = data.lastError
                                    ? 'Translation failed: ' + data.lastError
                                    : 'Translation failed. Check the Craft queue for details.';
                                Craft.cp.displayError(errMsg);
                                enableAllButtons();
                            } else {
                                Craft.cp.displayNotice('Translation to ' + siteName + ' complete! Reloading…');
                                setTimeout(function() { window.location.reload(); }, 1200);
                            }
                        })
                        .catch(function(err) {
                            consecutiveErrors++;
                            if (consecutiveErrors >= 3) {
                                stopPolling();
                                enableAllButtons();
                                var status = err && err.response && err.response.status;
                                Craft.cp.displayError('Cannot check translation status (HTTP ' + (status || '?') + '). Reload the page to see translated content.');
                            }
                        });

                    if (polls >= maxPolls) {
                        stopPolling();
                        enableAllButtons();
                        Craft.cp.displayNotice('Translation is still running in the background. Reload manually when ready.');
                    }
                }

                doPoll();
                _pollInterval = setInterval(doPoll, 2000);
            }

            function disableAllButtons() {
                $('.auto-translator-trigger-btn, .auto-translator-inplace-btn').addClass('loading').attr('disabled', true);
            }

            function enableAllButtons() {
                $('.auto-translator-trigger-btn, .auto-translator-inplace-btn').removeClass('loading').attr('disabled', false);
            }

            $(document).ready(function() {
                if ($('#auto-translator-sidebar').closest('#auto-translator-injected').length > 0) {
                    var $target = $('#settings, #details').first();
                    if ($target.length > 0) {
                        $target.append($('#auto-translator-sidebar'));
                    }
                }

                $(document).on('click', '.auto-translator-inplace-btn', function(e) {
                    e.preventDefault();
                    disableAllButtons();
                    stopPolling();

                    var siteId = resolveCurrentSiteId();
                    var payload = {
                        elementId: {{ element.id }},
                        siteId: siteId
                    };

                    // Show feedback immediately — on shared hosting the POST
                    // can take several seconds to return because the queue
                    // runs inline. Don't leave the user staring at nothing.
                    Craft.cp.displayNotice('Translating to ' + siteNameForId(siteId) + '… working');

                    Craft.sendActionRequest('POST', 'auto-translator/translate/translate-in-place', { data: payload })
                        .then(function(response) {
                            startPolling(siteNameForId(siteId));
                        })
                        .catch(function(err) {
                            enableAllButtons();
                            var msg = (err && err.response && err.response.data && err.response.data.error)
                                || (err && err.message)
                                || 'Translation failed.';
                            Craft.cp.displayError(msg);
                        });
                });

                $(document).on('click', '.auto-translator-trigger-btn', function(e) {
                    e.preventDefault();
                    var $btn = $(this);
                    var targetSiteId = $btn.data('target');
                    var siteName = $btn.data('site-name') || 'site';

                    disableAllButtons();
                    stopPolling();

                    var sourceSiteId = resolveCurrentSiteId();
                    var payload = {
                        elementId: {{ element.id }},
                        sourceSiteId: sourceSiteId,
                        targetSiteId: targetSiteId
                    };

                    // Immediate feedback — POST can take several seconds on
                    // shared hosting because the queue runs inline.
                    Craft.cp.displayNotice('Translating to ' + siteName + '… working');

                    Craft.sendActionRequest('POST', 'auto-translator/translate/element', { data: payload })
                        .then(function(response) {
                            startPolling(siteName);
                        })
                        .catch(function(err) {
                            enableAllButtons();
                            var msg = (err && err.response && err.response.data && err.response.data.error)
                                || (err && err.message)
                                || 'Translation failed.';
                            Craft.cp.displayError(msg);
                        });
                });
            });
        })();
    {% endjs %}
{% endif %}
